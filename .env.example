# ============================================================
# SciLoom 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，请勿提交。
# ============================================================

# ---------- 大模型（对话 / 规划 / 生成）----------
# 兼容 OpenAI 协议的服务商均可：DeepSeek、阿里百炼、Moonshot、本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
# 需要强推理的任务（综述、版本 diff、Future Work 判断）单独指定；留空则复用 LLM_MODEL
LLM_REASONING_MODEL=deepseek-reasoner

# ---------- 多模态（扫描件版面理解，可选）----------
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ---------- 向量与重排 ----------
# local: 本地 sentence-transformers 加载 BGE-M3（需 GPU/较大内存）
# api  : 调用兼容 OpenAI 协议的 embedding 接口
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 国内网络无法直连 huggingface.co，默认走镜像；海外部署改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
# 模型已缓存后可置 true，跳过每次启动对 Hub 的连通性探测（国内常超时 3 分钟）
HF_OFFLINE=false

# ---------- 翻译 ----------
# auto：有 LLM Key 走大模型，否则走本地 MT；也可强制 llm | local
TRANSLATION_BACKEND=auto
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-zh

# ---------- 解析 ----------
# OCR 引擎：paddle | tesseract | none
OCR_ENGINE=paddle
OCR_LANG=eng+chi_sim
# 单篇文档最大页数，超出则强制分片入库（防 OOM）
MAX_PAGES_INLINE=200
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------- 学术数据源 ----------
ARXIV_MAX_RESULTS=50
ARXIV_REQUEST_DELAY=3
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# ---------- 运行 ----------
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/sciloom.db
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
